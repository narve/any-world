# /etc/anyworld.env — read by deploy/anyworld.service. Keep it private:
#   sudo install -m 600 -o root -g root deploy/anyworld.env.example /etc/anyworld.env
# then fill in the values. Never commit the real file.

# Port the server listens on (Tailscale/WireGuard/Caddy point here). HOST 127.0.0.1 keeps it off the
# LAN when a tunnel or reverse proxy on the same machine does the exposing.
PORT=8787
HOST=127.0.0.1

# AI provider keys: set at least one (README → AI providers). Use keys with a spending limit.
ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# Access code players enter in Settings before the AI may create worlds or run the game master.
# Demo worlds stay open. Use a long random phrase, e.g. `openssl rand -base64 18`.
ANYWORLD_HOST_CODE=

# Only when the web pages are hosted elsewhere (e.g. GitHub Pages): their origins, comma-separated.
# ALLOWED_ORIGINS=https://any.dv8.no,https://narve.github.io

# Behind a reverse proxy (Caddy on a VPS, Cloudflare): number of proxy hops, so rate limits see the
# real client IP. Required behind Caddy (the chosen setup) once rooms are in use: otherwise every
# player shares the proxy's address and its per-IP socket limits. Remove it for Tailscale Funnel or a
# direct connection (clients could then fake their address).
TRUST_PROXY=1

# Multiplayer rooms (MP2): room files live in $ANYWORLD_DATA_DIR/rooms. The unit's StateDirectory
# makes /var/lib/anyworld; the server creates rooms/ there at start-up and refuses to start if it cannot.
ANYWORLD_DATA_DIR=/var/lib/anyworld
# open rooms at most (default 10)
# ANYWORLD_MAX_ROOMS=10

# Rate limit for AI calls per client IP.
LLM_RATE_PER_MIN=30
LLM_RATE_BURST=10
