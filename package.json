{
  "name": "anyworld",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AnyWorld — a turn-based roguelike whose world, genre and rules are invented by an AI at the start of every run.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/dev.ts",
    "dev:client": "vite",
    "build": "vite build",
    "build:static": "vite build --mode static",
    "serve:static": "tsx server/serve-static.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx tools/sim.ts",
    "validate-worlds": "tsx tools/validate-worlds.ts",
    "e2e": "xvfb-run -a playwright test"
  },
  "dependencies": {
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
